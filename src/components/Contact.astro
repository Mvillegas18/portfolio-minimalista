---
import SectionHeading from './SectionHeading.astro';
import T from './T.astro';
import { site } from '../data/site';

/** `id` matches the `sections.contact.channels.<id>` translation namespace. */
const channels = [
  {
    id: 'email',
    value: site.email,
    href: `mailto:${site.email}`,
    external: false,
    icon: 'M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Zm0 0 8 6 8-6',
  },
  {
    id: 'github',
    value: '@miguelvillegas',
    href: site.social.github,
    external: true,
    icon: 'M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21',
  },
  {
    id: 'linkedin',
    value: '/in/miguelvillegas',
    href: site.social.linkedin,
    external: true,
    icon: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6ZM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z',
  },
];
---

<section id="contact" aria-labelledby="contact-title" class="scroll-mt-24 pt-24">
  <SectionHeading id="contact" k="contact" />

  <div class="grid gap-4 sm:grid-cols-3">
    {
      channels.map((channel) => (
        <a
          href={channel.href}
          target={channel.external ? '_blank' : undefined}
          rel={channel.external ? 'noopener noreferrer' : undefined}
          class="group flex flex-col rounded-xl border border-neutral-200 bg-white p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent-300 hover:shadow-[0_8px_30px_rgb(0_0_0/0.04)] dark:border-neutral-800 dark:bg-neutral-900/50 dark:hover:border-accent-700 reveal"
        >
          <span class="inline-flex size-9 items-center justify-center rounded-lg bg-neutral-100 text-neutral-500 transition-colors group-hover:bg-accent-600 group-hover:text-white dark:bg-neutral-900 dark:text-neutral-400 dark:group-hover:bg-accent-500">
            <svg
              class="size-4.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={channel.icon} />
            </svg>
          </span>

          <span class="mt-4 font-mono text-[11px] uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
            <T k={`sections.contact.channels.${channel.id}.label`} />
          </span>

          <span class="mt-1 truncate text-sm font-medium text-neutral-800 dark:text-neutral-200">
            {channel.value}
          </span>

          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent-700 dark:text-accent-400">
            <T k={`sections.contact.channels.${channel.id}.cta`} />
            <svg
              class="size-4 transition-transform duration-300 group-hover:translate-x-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      ))
    }
  </div>
</section>
