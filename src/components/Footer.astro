---
import T from './T.astro';
import { site } from '../data/site';
import { DEFAULT_LANG, getText } from '../i18n';

const year = new Date().getFullYear();
const emailLabel = getText(DEFAULT_LANG, 'sections.contact.channels.email.label');
---

<footer class="mt-24 border-t border-neutral-200 dark:border-neutral-800">
  <div
    class="container-page flex flex-col items-start justify-between gap-4 py-8 sm:flex-row sm:items-center"
  >
    <p class="text-sm text-neutral-500 dark:text-neutral-400">
      <span>© {year} {site.name}</span>
      <T k="footer.builtWith" class="ml-2" />
      <a
        href="https://astro.build"
        target="_blank"
        rel="noopener noreferrer"
        class="ml-1 font-medium text-neutral-700 underline-offset-4 transition-colors hover:text-accent-600 hover:underline dark:text-neutral-300 dark:hover:text-accent-400"
        >Astro</a
      >
      <span class="mx-1">&</span>
      <a
        href="https://tailwindcss.com"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-neutral-700 underline-offset-4 transition-colors hover:text-accent-600 hover:underline dark:text-neutral-300 dark:hover:text-accent-400"
        >Tailwind CSS</a
      ><span>.</span>
    </p>

    <div class="flex items-center gap-5">
      <a
        href={site.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-400 transition-colors hover:text-neutral-900 dark:hover:text-white"
        aria-label="GitHub"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.12-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.8 5.65-5.48 5.95.43.37.81 1.1.81 2.22 0 1.61-.01 2.9-.01 3.29 0 .32.21.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
          ></path>
        </svg>
      </a>
      <a
        href={site.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-400 transition-colors hover:text-neutral-900 dark:hover:text-white"
        aria-label="LinkedIn"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"
          ></path>
        </svg>
      </a>
      <a
        href={`mailto:${site.email}`}
        class="text-neutral-400 transition-colors hover:text-neutral-900 dark:hover:text-white"
        aria-label={emailLabel}
        data-i18n-aria="sections.contact.channels.email.label"
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Zm0 0 8 6 8-6"></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
