---
import SectionHeading from './SectionHeading.astro';
import T from './T.astro';
import { experiences } from '../data/experience';
---

<section id="experience" aria-labelledby="experience-title" class="scroll-mt-24 pt-24">
  <SectionHeading id="experience" k="experience" />

  <ol class="relative space-y-6 border-l border-neutral-200 pl-6 dark:border-neutral-800 sm:pl-8">
    {
      experiences.map((job, i) => (
        <li class="relative reveal">
          <span class="absolute -left-[1.66rem] top-6 size-3 rounded-full border-2 border-white bg-accent-600 dark:border-neutral-950 dark:bg-accent-500 sm:-left-[2.16rem]" />

          <article class="rounded-xl border border-neutral-200 bg-white p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent-300 hover:shadow-[0_8px_30px_rgb(0_0_0/0.04)] dark:border-neutral-800 dark:bg-neutral-900/50 dark:hover:border-accent-700">
            <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2">
              <div>
                <h3 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-white">
                  <T k={`experience.${i}.role`} />
                </h3>
                <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
                  <span class="font-medium text-accent-700 dark:text-accent-400">
                    <T k={`experience.${i}.company`} />
                  </span>
                  <span class="mx-2 text-neutral-300 dark:text-neutral-600">·</span>
                  <T k={`experience.${i}.location`} />
                </p>
              </div>

              <div class="flex flex-col items-start gap-1 sm:items-end">
                <time class="font-mono text-xs text-neutral-500 dark:text-neutral-400">
                  <T k={`experience.${i}.period`} />
                </time>
                <span class="rounded-full border border-neutral-200 px-2 py-0.5 text-[11px] font-medium text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
                  <T k={`experience.${i}.type`} />
                </span>
              </div>
            </div>

            <p class="mt-4 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
              <T k={`experience.${i}.summary`} />
            </p>

            <ul class="mt-4 space-y-2">
              {job.achievements.map((_, j) => (
                <li class="flex gap-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
                  <svg
                    class="mt-1 size-4 shrink-0 text-accent-600 dark:text-accent-400"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <T k={`experience.${i}.achievements.${j}`} />
                </li>
              ))}
            </ul>

            <ul class="mt-5 flex flex-wrap gap-1.5">
              {job.tech.map((t) => (
                <li class="rounded-md bg-neutral-100 px-2 py-1 font-mono text-[11px] text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
                  {t}
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</section>
