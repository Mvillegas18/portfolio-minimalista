---
import SectionHeading from './SectionHeading.astro';
import T from './T.astro';
import { skillCategories } from '../data/skills';
---

<section id="skills" aria-labelledby="skills-title" class="scroll-mt-24 pt-8">
  <SectionHeading id="skills" k="skills" />

  <div class="grid gap-4 sm:grid-cols-2">
    {
      skillCategories.map((category, i) => (
        <article class="group rounded-xl border border-neutral-200 bg-white p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent-300 hover:shadow-[0_8px_30px_rgb(0_0_0/0.04)] dark:border-neutral-800 dark:bg-neutral-900/50 dark:hover:border-accent-700 reveal">
          <div class="flex items-start gap-3">
            <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-neutral-100 text-neutral-500 transition-colors group-hover:bg-accent-600 group-hover:text-white dark:bg-neutral-900 dark:text-neutral-400 dark:group-hover:bg-accent-500">
              <svg
                class="size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={category.icon} />
              </svg>
            </span>
            <div class="min-w-0">
              <h3 class="text-base font-semibold text-neutral-900 dark:text-white">
                <T k={`skills.${i}.title`} />
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
                <T k={`skills.${i}.description`} />
              </p>
            </div>
          </div>

          <ul class="mt-5 flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <li class="rounded-md border border-neutral-200 bg-neutral-50 px-2.5 py-1 font-mono text-xs text-neutral-700 transition-colors hover:border-accent-300 hover:text-accent-700 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:border-accent-700 dark:hover:text-accent-300">
                {skill}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
