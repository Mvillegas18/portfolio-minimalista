---
/**
 * ES / EN switcher. Text swapping logic lives in `src/i18n/dom.ts`.
 */
import { DEFAULT_LANG, LANGS } from '../i18n';
import { getText } from '../i18n';
---

<div
  role="group"
  aria-label={getText(DEFAULT_LANG, 'ui.language')}
  data-i18n-aria="ui.language"
  class="flex shrink-0 items-center gap-0.5 rounded-lg border border-neutral-200 p-0.5 dark:border-neutral-800"
>
  {
    LANGS.map(({ code, label }) => (
      <button
        type="button"
        data-lang-option={code}
        aria-pressed={code === DEFAULT_LANG ? 'true' : 'false'}
        class="rounded-md px-2 py-1 font-mono text-[11px] font-semibold uppercase tracking-wider text-neutral-500 transition-colors hover:text-neutral-900 aria-pressed:bg-neutral-900 aria-pressed:text-white dark:text-neutral-400 dark:hover:text-white dark:aria-pressed:bg-white dark:aria-pressed:text-neutral-900"
      >
        {label}
      </button>
    ))
  }
</div>

<script>
  import { DEFAULT_LANG, isLang } from '../i18n';
  import { applyLanguage, getStoredLang } from '../i18n/dom';

  const bind = () => {
    // Restore the persisted language (Spanish is already rendered server-side).
    const stored = getStoredLang();
    if (stored !== DEFAULT_LANG) applyLanguage(stored);

    document.querySelectorAll<HTMLButtonElement>('[data-lang-option]').forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const next = button.dataset.langOption;
        if (!isLang(next) || next === getStoredLang()) return;
        applyLanguage(next, { preserveScroll: true });
      });
    });
  };

  bind();
  document.addEventListener('astro:page-load', bind);
</script>
