---
/**
 * Reusable project card. Renders any object matching the `Project` type, so
 * adding a project only requires editing `src/data/projects.ts`.
 * Localized strings are resolved through the translation key of `index`.
 */
import type { Project } from '../data/projects';
import T from './T.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { tech, demo, github, tag } = project;
---

<article
  class="group relative flex flex-col rounded-xl border border-neutral-200 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent-300 hover:shadow-[0_12px_40px_rgb(0_0_0/0.06)] dark:border-neutral-800 dark:bg-neutral-900/50 dark:hover:border-accent-700 reveal"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-2 text-neutral-400 dark:text-neutral-500">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z" />
      </svg>
      <span class="font-mono text-[11px] uppercase tracking-wider">
        <T k="sections.projects.kindLabel" />
      </span>
    </div>

    {
      tag && (
        <span class="rounded-full bg-accent-600/10 px-2.5 py-0.5 font-mono text-[11px] font-medium uppercase tracking-wider text-accent-700 dark:bg-accent-500/15 dark:text-accent-300">
          <T k={`projects.${index}.tag`} />
        </span>
      )
    }
  </div>

  <h3 class="mt-5 text-xl font-semibold tracking-tight text-neutral-900 transition-colors group-hover:text-accent-700 dark:text-white dark:group-hover:text-accent-300">
    <T k={`projects.${index}.title`} />
  </h3>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
    <T k={`projects.${index}.description`} />
  </p>

  <ul class="mt-5 flex flex-wrap gap-1.5">
    {
      tech.map((t) => (
        <li class="rounded-md bg-neutral-100 px-2 py-1 font-mono text-[11px] text-neutral-600 dark:bg-neutral-900 dark:text-neutral-400">
          {t}
        </li>
      ))
    }
  </ul>

  <div class="mt-6 flex items-center gap-4 border-t border-neutral-100 pt-4 dark:border-neutral-800">
    <a
      href={demo}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-neutral-700 transition-colors hover:text-accent-600 dark:text-neutral-300 dark:hover:text-accent-400"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3" />
      </svg>
      <span class="sr-only sm:not-sr-only"><T k="sections.projects.demo" /></span>
    </a>

    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-neutral-700 transition-colors hover:text-accent-600 dark:text-neutral-300 dark:hover:text-accent-400"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.12-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.8 5.65-5.48 5.95.43.37.81 1.1.81 2.22 0 1.61-.01 2.9-.01 3.29 0 .32.21.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"
        ></path>
      </svg>
      <span class="sr-only sm:not-sr-only"><T k="sections.projects.code" /></span>
    </a>
  </div>
</article>
