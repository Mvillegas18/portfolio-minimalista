---
/**
 * Shared section heading. Reads `sections.<k>.{index,title,subtitle}` from the
 * active dictionaries — Spanish at build time, swapped client-side on toggle.
 */
import T from './T.astro'

interface Props {
	/** Element id used by the section's `aria-labelledby`. */
	id: string
	/** Translation namespace, e.g. `skills` → `sections.skills.*`. */
	k: string
}

const { id, k } = Astro.props
---

<header class="mb-10 reveal">
	<p
		class="font-mono text-lg font-medium uppercase tracking-[0.2em] text-accent-600 sm:text-sm dark:text-accent-400">
		<T k={`sections.${k}.index`} />
	</p>
	<h2
		id={`${id}-title`}
		class="mt-3 text-3xl font-semibold tracking-tight text-neutral-900 dark:text-white sm:text-4xl">
		<T k={`sections.${k}.title`} />
	</h2>
	<p
		class="mt-3 max-w-2xl text-base leading-relaxed text-neutral-500 dark:text-neutral-400">
		<T k={`sections.${k}.subtitle`} />
	</p>
</header>
